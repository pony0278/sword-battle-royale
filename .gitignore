# G2 Skyrim Guard probe: keep proprietary/raw authoring inputs and unreviewed converted GLBs local.
tools/skyrim-hkx-bridge/work/
assets/skyrim/guard/converted/*.glb
!assets/skyrim/guard/converted/shd_blockidle.source.glb

# Local dev dependencies (three.js is loaded from a CDN at runtime; npm install is only for headless probes).
node_modules/

# Vite build output: the bundled lab page, its chunks, and a copy of the animation packs the page
# fetches at runtime. Generated by npm run build:web, which verify:combat runs before every gate and
# publish-gh-pages.sh overlays onto the site. Never edited, never committed - 35MB of it is a copy
# of assets/.
dist/

# graphify knowledge graph output. Generated by the graphify skill (.claude/skills/graphify);
# rebuilt from source with `graphify update .`, so it is never the source of truth and never
# reviewed. graph.json alone is ~8.7MB.
graphify-out/
